{
  "format_version": "1.2",
  "resource_changes": [
    {
      "address": "aws_s3_bucket.artifacts",
      "type": "aws_s3_bucket",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "bucket": "orders-artifacts",
          "tags_all": {
            "Owner": "platform",
            "CostCenter": "cc-1042",
            "Environment": "dev"
          }
        }
      }
    },
    {
      "address": "aws_s3_bucket_public_access_block.artifacts",
      "type": "aws_s3_bucket_public_access_block",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "block_public_acls": true,
          "block_public_policy": true,
          "ignore_public_acls": true,
          "restrict_public_buckets": true
        }
      }
    },
    {
      "address": "aws_iam_role_policy.app",
      "type": "aws_iam_role_policy",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "policy": "{\"Statement\": [{\"Effect\": \"Allow\", \"Action\": [\"s3:GetObject\"], \"Resource\": \"arn:aws:s3:::orders-artifacts/*\"}]}"
        }
      }
    }
  ]
}